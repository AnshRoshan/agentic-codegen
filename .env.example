
# Local development
# DB: run `node scripts/embedded-db.cjs` for an isolated embedded PostgreSQL on port 5434
# (or point DATABASE_URL at your own PostgreSQL and run `npx drizzle-kit push`)

# Optional: env-key fallbacks for the agent engine (Settings UI takes priority)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# DEEPSEEK_API_KEY=        # V4 models (api.deepseek.com) - powers DeepSeek Harness
# ZHIPU_API_KEY=           # GLM-5.3 (api.z.ai) - powers ZCode harness
# AI_MODEL=
